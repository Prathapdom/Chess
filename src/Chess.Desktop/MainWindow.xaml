<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="Chess.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Chess">
    <Grid x:Name="RootGrid" Background="{ThemeResource AppBackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="AppTitleBar" Grid.Row="0" Background="{ThemeResource AppBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="240" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="18,0,0,0" VerticalAlignment="Center" Orientation="Horizontal" Spacing="10">
                <TextBlock FontSize="23" Foreground="{StaticResource AccentBrush}" Text="♞" />
                <TextBlock VerticalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" Text="CHESS" />
            </StackPanel>
            <TextBlock Grid.Column="1" Margin="16,0,140,0" VerticalAlignment="Center" Foreground="{ThemeResource MutedBrush}" Text="A focused, Lichess-inspired chess board" />
        </Grid>

        <Grid Grid.Row="1" Margin="28,20,28,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="340" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="12" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" CornerRadius="18">
                <Grid x:Name="BoardGrid" Width="640" Height="640" />
            </Border>

            <ScrollViewer Grid.Column="1" Margin="28,0,0,0" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="14">
                    <StackPanel Spacing="3">
                        <TextBlock FontSize="26" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" Text="Play chess" />
                        <TextBlock Foreground="{ThemeResource MutedBrush}" Text="Local games are ready now; online games use the API." TextWrapping="Wrap" />
                    </StackPanel>

                    <Border Padding="16" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" CornerRadius="14">
                        <StackPanel Spacing="10">
                            <TextBlock x:Name="StatusText" FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" Text="White to move" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Spacing="2">
                                    <TextBlock FontSize="11" Foreground="{ThemeResource SubtleBrush}" Text="WHITE" />
                                    <TextBlock x:Name="WhiteClockText" FontFamily="Consolas" FontSize="25" Foreground="{ThemeResource InkBrush}" Text="05:00" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Spacing="2">
                                    <TextBlock FontSize="11" Foreground="{ThemeResource SubtleBrush}" Text="BLACK" />
                                    <TextBlock x:Name="BlackClockText" FontFamily="Consolas" FontSize="25" Foreground="{ThemeResource InkBrush}" Text="05:00" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Style="{StaticResource AccentButtonStyle}" Click="NewGame_Click" Content="New local game" />
                                <Button Click="Resign_Click" Content="Resign" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Padding="16" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" CornerRadius="14">
                        <StackPanel Spacing="10">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" Text="Online game" />
                            <TextBox x:Name="ServerUrlBox" Header="API address" Text="http://localhost:5180" />
                            <TextBox x:Name="GameIdBox" Header="Game id" PlaceholderText="Paste an existing id, or create one" />
                            <ComboBox x:Name="OnlineColorBox" Header="Your color" SelectedIndex="0">
                                <ComboBoxItem Content="White" Tag="White" />
                                <ComboBoxItem Content="Black" Tag="Black" />
                            </ComboBox>
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Style="{StaticResource AccentButtonStyle}" Click="CreateOnline_Click" Content="Create game" />
                                <Button Click="LoadOnline_Click" Content="Load game" />
                            </StackPanel>
                            <TextBlock x:Name="OnlineStatusText" FontSize="12" Foreground="{ThemeResource MutedBrush}" Text="Not connected" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border Padding="16" Background="{ThemeResource SurfaceBrush}" BorderBrush="{ThemeResource LineBrush}" BorderThickness="1" CornerRadius="14">
                        <StackPanel Spacing="7">
                            <TextBlock FontSize="16" FontWeight="SemiBold" Foreground="{ThemeResource InkBrush}" Text="Move history" />
                            <ListView x:Name="MoveListView" Height="150" BorderThickness="0" Background="Transparent" />
                        </StackPanel>
                    </Border>

                    <TextBlock FontSize="12" Foreground="{ThemeResource SubtleBrush}" Text="Click a piece, then its destination. Promotion defaults to a queen in this first slice." TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Grid>
</Window>
