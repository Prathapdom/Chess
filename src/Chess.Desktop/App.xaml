<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Chess.Desktop.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#0C0F16" />
                    <SolidColorBrush x:Key="NavBackgroundBrush" Color="#10141D" />
                    <SolidColorBrush x:Key="InkBrush" Color="#F6F2E9" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#9AA3B2" />
                    <SolidColorBrush x:Key="SubtleBrush" Color="#697386" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#171B25" />
                    <SolidColorBrush x:Key="Surface2Brush" Color="#202633" />
                    <SolidColorBrush x:Key="LineBrush" Color="#2E3544" />
                    <SolidColorBrush x:Key="LightSquareBrush" Color="#D9C7A8" />
                    <SolidColorBrush x:Key="DarkSquareBrush" Color="#8A6248" />
                    <SolidColorBrush x:Key="HighlightBrush" Color="#E6B84E" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F7F5F1" />
                    <SolidColorBrush x:Key="NavBackgroundBrush" Color="#EEEAE3" />
                    <SolidColorBrush x:Key="InkBrush" Color="#171A20" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#626B78" />
                    <SolidColorBrush x:Key="SubtleBrush" Color="#747B86" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="Surface2Brush" Color="#E8E4DC" />
                    <SolidColorBrush x:Key="LineBrush" Color="#D7D2CA" />
                    <SolidColorBrush x:Key="LightSquareBrush" Color="#F0D9B5" />
                    <SolidColorBrush x:Key="DarkSquareBrush" Color="#B58863" />
                    <SolidColorBrush x:Key="HighlightBrush" Color="#D09220" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <Color x:Key="AccentColor">#FF6A3D</Color>
            <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
            <Style TargetType="Button">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14,9" />
            </Style>
            <Style x:Key="AccentButtonStyle" TargetType="Button">
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="14,9" />
                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                <Setter Property="Foreground" Value="White" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
